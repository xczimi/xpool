#!/bin/bash
# xpool worktree switcher (single-window, layout-robust).
#
# Repoints the dev session's api + web servers at a chosen worktree:
#   1. finds the api/web panes by their tmux @role marker (NOT by index, and
#      NOT by pane title — the fish/tide prompt rewrites titles every command);
#   2. stops the current stack by PORT + C-c, so it dies no matter which pane
#      or fallback port it landed on;
#   3. relaunches api + web there, pointed at the worktree.
#
# Docker/DynamoDB is left running (shared infra). Companion to bin/tmux, which
# sets the @role markers when it builds the session.
set -euo pipefail

SESSION="xpool"
PROJECT="$HOME/Private/SoccerPool/xpool"
DYNAMO_ENDPOINT="http://localhost:8000"
API_PORT=3000
WEB_PORT=5173

die() { echo "bin/switch: $*" >&2; exit 1; }

tmux has-session -t "$SESSION" 2>/dev/null \
    || die "no '$SESSION' tmux session — start it with bin/tmux first"

# --- resolve target worktree -------------------------------------------------
#   (no arg)      -> main checkout (master)
#   existing dir  -> that directory
#   a bare name   -> $PROJECT/.claude/worktrees/<name>
arg="${1:-}"
if [ -z "$arg" ]; then
    WT="$PROJECT"
elif [ -d "$arg" ]; then
    WT="$(cd "$arg" && pwd)"
else
    WT="$PROJECT/.claude/worktrees/$arg"
fi
[ -d "$WT/web" ] || {
    echo "bin/switch: not an xpool worktree (no web/): $WT" >&2
    echo "worktrees:" >&2
    git -C "$PROJECT" worktree list >&2
    exit 1
}

# --- locate panes by @role (stable; shell can't overwrite it) ----------------
pane_by_role() {
    tmux list-panes -s -t "$SESSION" -F '#{@role}'$'\t''#{pane_id}' \
        | awk -F'\t' -v r="$1" '$1==r {print $2; exit}'
}
API_PANE="$(pane_by_role api)"
WEB_PANE="$(pane_by_role web)"
[ -n "$API_PANE" ] || die "no pane tagged '@role api' — (re)start the session with bin/tmux"
[ -n "$WEB_PANE" ] || die "no pane tagged '@role web' — (re)start the session with bin/tmux"

# --- stop the current stack (port-based + C-c; index-free) -------------------
port_pids() { lsof -ti tcp:"$1" -sTCP:LISTEN 2>/dev/null || true; }
kill_port() { local p; p="$(port_pids "$1")"; [ -n "$p" ] && kill $p 2>/dev/null || true; }

echo "==> stopping current stack (:$API_PORT, :$WEB_PORT)"
kill_port "$API_PORT"
kill_port "$WEB_PORT"
tmux send-keys -t "$API_PANE" C-c   # also catches a server on a fallback port
tmux send-keys -t "$WEB_PANE" C-c

# wait (up to ~5s) for both ports to actually free before relaunch
for _ in $(seq 1 20); do
    if [ -z "$(port_pids "$API_PORT")" ] && [ -z "$(port_pids "$WEB_PORT")" ]; then
        break
    fi
    sleep 0.25
done

# --- relaunch pointed at the worktree ----------------------------------------
# Each worktree builds into its OWN target/ — do NOT share CARGO_TARGET_DIR.
# A shared target lets cargo serve an `api` binary built from a *different*
# worktree (same package id), so you'd run code that isn't in the worktree you
# switched to. Correctness beats the saved compile time.
#
# DYNAMO_ENDPOINT inline (panes don't inherit this script's env), matching
# bin/tmux. LOCAL_AUTH_ISSUER=1 mounts the dev-login route: a worktree has no
# .env in its own dir, so we set it explicitly rather than rely on dotenvy
# finding the main checkout's .env up the tree.
echo "==> starting api + web for $WT"
echo "    docker/DynamoDB untouched — re-run 'xtask import' + 'seed' if this branch changed schema/data"
tmux send-keys -t "$API_PANE" \
    "cd $WT && DYNAMO_ENDPOINT=$DYNAMO_ENDPOINT LOCAL_AUTH_ISSUER=1 cargo run -p api" C-m
tmux send-keys -t "$WEB_PANE" "cd $WT/web && npm install && npm run dev" C-m
