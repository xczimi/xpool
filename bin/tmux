#!/bin/bash
# xpool dev-session restarter. See docs/superpowers/specs/2026-05-18-tmux-restarter-design.md
set -euo pipefail

SESSION="xpool"
PROJECT="$HOME/Private/SoccerPool/xpool"
DYNAMO_ENDPOINT="http://localhost:8000"
export DYNAMO_ENDPOINT

# Re-attach if the session already exists — no data or containers touched.
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux -CC attach -t "$SESSION"
fi

# --- Bootstrap (fresh session only) ----------------------------------------
# Runs before any panes are created so ordering is guaranteed:
# docker up -> DynamoDB ready -> import -> seed.
cd "$PROJECT"

echo "==> docker compose up -d"
docker compose up -d

echo "==> waiting for DynamoDB Local on :8000"
until nc -z localhost 8000 2>/dev/null; do sleep 0.5; done

echo "==> xtask import"
cargo run -p xtask -- import tournaments/fwc26.json

echo "==> xtask seed"
cargo run -p xtask -- seed

# --- tmux session ----------------------------------------------------------
# Pane 0 (left): interactive claude session.
tmux new-session -d -s "$SESSION" -c "$PROJECT"
tmux send-keys -t "$SESSION:0.0" 'claude' C-m

# Pane 1 (right, top): docker logs.
tmux split-window -h -t "$SESSION:0.0" -c "$PROJECT"
tmux send-keys -t "$SESSION:0.1" 'docker compose logs -f' C-m

# Pane 2 (right, middle): API server. Panes don't inherit the script env,
# so DYNAMO_ENDPOINT is passed inline.
tmux split-window -v -t "$SESSION:0.1" -c "$PROJECT"
tmux send-keys -t "$SESSION:0.2" "DYNAMO_ENDPOINT=$DYNAMO_ENDPOINT cargo run -p api" C-m

# Pane 3 (right, bottom): web dev server.
tmux split-window -v -t "$SESSION:0.2" -c "$PROJECT/web"
tmux send-keys -t "$SESSION:0.3" 'npm run dev' C-m

# Even out the three right-column panes, then focus claude.
tmux select-layout -t "$SESSION" main-vertical
tmux select-pane -t "$SESSION:0.0"

exec tmux -CC attach -t "$SESSION"
