#!/bin/bash
# xpool data: (re-)import the tournament into a DEPLOYED environment's table.
#
# Usage: bin/deploy-data [dev|prod] [--seed|--bootstrap] [--dry-run]  # default: dev
#
# The deploy-* siblings ship CODE; this ships DATA. It runs the same xtask
# `import` the local stack uses (bin/local-stack), but against the real
# DynamoDB table for the named env (DYNAMO_ENDPOINT unset -> real AWS). Use it
# when tournaments/<tid>.json changes under an already-seeded table — e.g. new
# team flags — since an existing table is never auto-re-imported.
#
#   import       non-destructive `put_tournament`: refreshes teams/games (and
#                their flags), leaves players & pools untouched. The default.
#   --seed       also load demo players + a demo pool (dev only; refused for prod).
#   --bootstrap  also create ONLY the result-user (no demo data) keyed at
#                result_user_email — the production admin bootstrap. Idempotent;
#                run it once on a fresh prod table so the operator's Auth0 login
#                resolves to the result-user. Mutually exclusive with --seed
#                (seed already creates the result-user).
#   --dry-run    print the resolved table/tournament + plan, write nothing.
#
# Table name and tournament id are DERIVED so they can't drift from the Lambda:
#   XPOOL_TABLE           = xpool-<env>          (matches module.dynamodb)
#   CURRENT_TOURNAMENT_ID = env/<env>.tfvars     (matches the Lambda's env)
#   tournament file       = tournaments/<tid>.json
set -euo pipefail

ENV="dev"; SEED=0; BOOTSTRAP=0; DRYRUN=0
for arg in "$@"; do
    case "$arg" in
        dev|prod)      ENV="$arg" ;;
        --seed)        SEED=1 ;;
        --bootstrap)   BOOTSTRAP=1 ;;
        --dry-run|-n)  DRYRUN=1 ;;
        *) echo "Usage: $0 [dev|prod] [--seed|--bootstrap] [--dry-run]" >&2; exit 2 ;;
    esac
done

# --seed already creates the result-user; --bootstrap is the no-demo subset.
# Asking for both is contradictory — fail loudly rather than guess.
if [[ "$SEED" == "1" && "$BOOTSTRAP" == "1" ]]; then
    echo "--seed and --bootstrap are mutually exclusive (seed includes the result-user)" >&2
    exit 2
fi

PROJECT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT"

# Default to the xczimi profile; override AWS_PROFILE (or export AWS_* keys).
export AWS_PROFILE="${AWS_PROFILE:-xczimi}"
export AWS_REGION="${AWS_REGION:-ca-central-1}"

# Pre-resolve the credentials (whatever the standard AWS chain finds:
# exported AWS_* keys, AWS_PROFILE, default profile, SSO, role) into static env
# vars NOW, so they are *present* before xtask loads `.env` via dotenvy — which
# ships dummy AWS_ACCESS_KEY_ID=local / AWS_SECRET_ACCESS_KEY=local for DynamoDB
# Local. Static keys outrank a profile, so without this the deploy authenticates
# as "local" and fails. Resolves the AWS_PROFILE default above (or your own).
# Capture first: `eval "$(cmd)"` would mask a resolution failure (eval of empty
# output still succeeds), so guard on the value being non-empty.
aws_creds="$(aws configure export-credentials --format env 2>/dev/null)" || aws_creds=""
[[ -n "$aws_creds" ]] || { echo "no AWS credentials in the execution context (set AWS_PROFILE or export AWS_* keys)" >&2; exit 1; }
eval "$aws_creds"

# Seeding demo data into prod is never right.
if [[ "$ENV" == "prod" && "$SEED" == "1" ]]; then
    echo "refusing --seed against prod (demo data must never hit prod)" >&2
    exit 1
fi

TFVARS="infrastructure/env/${ENV}.tfvars"
[[ -f "$TFVARS" ]] || { echo "missing $TFVARS" >&2; exit 1; }

# current_tournament_id = "fwc26"  ->  fwc26
TID="$(sed -n 's/.*current_tournament_id[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$TFVARS")"
[[ -n "$TID" ]] || { echo "could not read current_tournament_id from $TFVARS" >&2; exit 1; }

TOURNAMENT="tournaments/${TID}.json"
[[ -f "$TOURNAMENT" ]] || { echo "missing $TOURNAMENT" >&2; exit 1; }

# result_user_email = "pool@xczimi.com"  ->  pool@xczimi.com  (the email the
# result-user/admin Identity is keyed under). Must match var.result_user_email
# in the Lambda env, or the operator's login won't resolve to the result-user.
# Falls back to xtask's own default when the tfvars line is absent.
RESULT_USER_EMAIL_VAL="$(sed -n 's/.*result_user_email[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$TFVARS")"

export XPOOL_TABLE="xpool-${ENV}"
export CURRENT_TOURNAMENT_ID="$TID"
[[ -n "$RESULT_USER_EMAIL_VAL" ]] && export RESULT_USER_EMAIL="$RESULT_USER_EMAIL_VAL"
# Force real AWS, NOT DynamoDB Local. Must be EMPTY, not unset: xtask loads
# `.env` via dotenvy, which re-injects `.env`'s DYNAMO_ENDPOINT=localhost:8000
# over an *absent* var — so a plain `unset` would silently seed local instead
# of AWS. An empty value is "present", so dotenvy leaves it alone, and the
# storage layer treats empty as real AWS.
export DYNAMO_ENDPOINT=""

PLAN="import"
[[ "$SEED" == "1" ]] && PLAN="import + seed"
[[ "$BOOTSTRAP" == "1" ]] && PLAN="import + bootstrap"
echo "==> env=$ENV  table=$XPOOL_TABLE  tournament=$TOURNAMENT  plan=$PLAN"
if [[ ( "$SEED" == "1" || "$BOOTSTRAP" == "1" ) && -n "${RESULT_USER_EMAIL:-}" ]]; then
    echo "==> result-user email=$RESULT_USER_EMAIL"
fi

if [[ "$DRYRUN" == "1" ]]; then
    echo "==> --dry-run: writing nothing"
    exit 0
fi

# A prod write has no throwaway table to undo it — require a typed confirm.
if [[ "$ENV" == "prod" ]]; then
    read -r -p "About to write to PROD table $XPOOL_TABLE. Type 'prod' to confirm: " reply
    [[ "$reply" == "prod" ]] || { echo "aborted" >&2; exit 1; }
fi

echo "==> xtask import $TOURNAMENT"
cargo run -q -p xtask -- import "$TOURNAMENT"

if [[ "$SEED" == "1" ]]; then
    echo "==> xtask seed (demo players + pool)"
    cargo run -q -p xtask -- seed
fi

if [[ "$BOOTSTRAP" == "1" ]]; then
    echo "==> xtask bootstrap (result-user only)"
    cargo run -q -p xtask -- bootstrap
fi

echo "==> done"
