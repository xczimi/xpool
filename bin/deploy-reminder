#!/bin/bash
# xpool reminder Lambda: cross-compile + push to ca-central-1.
#
# Usage: bin/deploy-reminder [dev|prod]   # default: dev
#
# Mirrors bin/deploy-api: build the arm64 zip, then update-function-code. Code is
# decoupled from tofu (module.reminder_lambda has ignore_source_code_hash = true),
# so this is what ships new reminder-Lambda code. It's a normal step of bin/deploy
# (infra api spa reminder), so a plain `bin/deploy <env>` keeps it current too.
#
# First deploy in a brand-new env: infra's create reads the zip from disk
# (create_package = false), so the zip must exist before that first `bin/deploy`
# — run `bin/build` once up front (it builds both Lambda zips). Steady-state
# deploys need nothing extra (each run leaves a fresh zip in target/). The
# automated heartbeat is armed separately: reminder_enabled = true in
# infrastructure/env/<env>.tfvars, then bin/deploy-infra — after the R1 gate.
set -euo pipefail

ENV="${1:-dev}"
case "$ENV" in
    dev | prod) ;;
    *)
        echo "Usage: $0 [dev|prod]"
        exit 2
        ;;
esac

PROJECT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT"

export AWS_PROFILE="${AWS_PROFILE:-xczimi}"
export AWS_REGION="${AWS_REGION:-ca-central-1}"

echo "==> cargo lambda build reminder (arm64, --features lambda)"
cargo lambda build -p api --bin reminder --release --arm64 --features lambda --output-format zip

ZIP="$PROJECT/target/lambda/reminder/bootstrap.zip"
if [[ ! -f "$ZIP" ]]; then
    echo "build did not produce $ZIP" >&2
    exit 1
fi

SIZE=$(stat -f%z "$ZIP" 2>/dev/null || stat -c%s "$ZIP")
echo "==> aws lambda update-function-code xpool-reminder-${ENV} ($((SIZE / 1024)) KB)"
aws lambda update-function-code \
    --function-name "xpool-reminder-${ENV}" \
    --zip-file "fileb://$ZIP" \
    --no-cli-pager \
    --query '{Version:Version,LastModified:LastModified,CodeSha256:CodeSha256}' \
    --output table
