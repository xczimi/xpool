#!/usr/bin/env bash
# Guard: the Rust workspace must be formatted by the pinned toolchain
# (rust-toolchain.toml) + rustfmt.toml. The local pre-commit hook
# (.githooks/pre-commit) calls this; a deferred CI job can reuse it too.
# Fix any failure with `cargo fmt`.
# See docs/superpowers/specs/2026-06-07-rustfmt-determinism-design.md.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE/.."

if out="$(cargo fmt --check 2>&1)"; then
  exit 0
fi

echo "✗ rustfmt: these files need 'cargo fmt':" >&2
printf '%s\n' "$out" | grep '^Diff in' | sed 's/^Diff in //; s/:[0-9].*//' | sort -u >&2
exit 1
