#!/bin/bash
# xpool infrastructure: tofu apply against the named env.
#
# Usage: bin/deploy-infra [dev|prod]   # default: dev
#
# Responsibility split (code is decoupled from infra via
# ignore_source_code_hash = true on module.api_lambda):
#
#   bin/deploy-infra  — touches the function shell, S3, CloudFront,
#                       DynamoDB, Route53, SSM, IAM (this script).
#   bin/deploy-api    — ships Lambda code (aws lambda update-function-code).
#   bin/deploy-spa    — ships the SPA bundle (S3 sync + CF invalidation).
#
# Interactive: `tofu apply` prompts for confirmation (no -auto-approve). Review
# the plan — especially for prod — and type `yes` to proceed.
#
# Env vars load via a gitignored `env.auto.tfvars` symlink (-> env/<env>.tfvars)
# that this script repoints on every run. OpenTofu auto-loads any *.auto.tfvars in
# the working dir, so a bare `tofu plan` / `tofu apply` you run by hand in
# infrastructure/ picks up the SAME env this script last selected — no forgotten
# -var-file silently applying default vars against the wrong env.
#
# Extra tofu flags after the env are passed through, so e.g.
#   bin/deploy-infra dev -target=module.cloudfront
#   bin/deploy-infra dev -refresh-only
set -euo pipefail

ENV="${1:-dev}"
case "$ENV" in
    dev|prod) [[ $# -gt 0 ]] && shift ;;
    *) echo "Usage: $0 [dev|prod] [extra tofu flags]"; exit 2 ;;
esac

PROJECT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT/infrastructure"

export AWS_PROFILE="${AWS_PROFILE:-xczimi}"

# .terraform/ holds the resolved backend for whichever env was last inited —
# dev and prod live in separate state objects (env/<env>.backend.hcl sets the
# S3 `key`). A plain `tofu apply` reuses that cached backend and does NOT re-read
# -backend-config, so switching env without re-initing would silently apply this
# env's tfvars against the LAST env's state. Guard against it: re-init whenever
# .terraform/ is absent or bound to a different env's state key.
WANT_KEY="xpool/infrastructure/${ENV}/terraform.tfstate"
HAVE_KEY="$(jq -r '.backend.config.key // empty' .terraform/terraform.tfstate 2>/dev/null || true)"
if [[ ! -d .terraform || "$HAVE_KEY" != "$WANT_KEY" ]]; then
    echo "==> tofu init -reconfigure -backend-config=env/${ENV}.backend.hcl"
    tofu init -reconfigure -backend-config="env/${ENV}.backend.hcl"
fi

# Repoint the auto-loaded tfvars symlink at the selected env, the same way the
# backend key is bound above. `-n` so an existing symlink is replaced, not
# followed. This is the var-loading half of the env switch; keeping it in lockstep
# with the backend binding is what makes dev<->prod switching safe.
[[ -f "env/${ENV}.tfvars" ]] || { echo "missing env/${ENV}.tfvars" >&2; exit 1; }
ln -sfn "env/${ENV}.tfvars" env.auto.tfvars
echo "==> env.auto.tfvars -> env/${ENV}.tfvars"

echo "==> tofu apply$([ $# -gt 0 ] && echo " $*")"
tofu apply "$@"
