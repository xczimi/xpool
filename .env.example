# xpool local-dev env. Copy to `.env` and edit. The file is gitignored —
# never commit your `.env`. The Rust binaries (api, xtask) load it via
# dotenvy on startup; the Vite SPA reads its own `web/.env.*` files.
#
# Lambda runtime env vars are NOT sourced from here — those are managed in
# `infrastructure/lambda.tf` / `infrastructure/env/*.tfvars`.

# --- DynamoDB Local ---
# DynamoDB Local runs in docker compose (see docker-compose.yml). The AWS SDK
# requires region + credentials even against the local emulator; values are
# arbitrary.
DYNAMO_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
XPOOL_TABLE=xpool
CURRENT_TOURNAMENT_ID=fwc26

# --- Auth seam (spec §2) ---
# Trust the local-issuer JWT path (required for the /api/dev/login flow and
# the integration tests). Empty / unset disables it.
LOCAL_AUTH_ISSUER=1

# Trust Auth0 too — required for testing the real Auth0 redirect against
# localhost. Empty / unset disables it (the dev-login path still works).
# When set, the SPA in Auth0 mode (web/.env.local with VITE_AUTH0_*) sends
# real Auth0 JWTs to the API.
AUTH0_DOMAIN=xpool.ca.auth0.com
AUTH0_AUDIENCE=xpool-api

# --- Admin / result-user ---
# Email that identifies the result-user (admin) Player in the seed. The
# Auth0 (or local-issuer) login that verifies this email resolves as the
# admin — they can enter official results via My Tips (ADMIN-04). For
# production, set this to the operator's verified email and re-run
# `xtask seed`.
#
# Default: result-user@dev.invalid (no one — admin disabled).
RESULT_USER_EMAIL=result-user@dev.invalid

# --- Invite codes (spec §5) ---
# Any 32-byte+ string. The production secret is provisioned by tofu
# (random_password.invite_code_secret). Rotating invalidates outstanding
# single-use invite codes (30-day TTL means natural rotation anyway).
INVITE_CODE_SECRET=local-dev-secret-must-be-32-bytes-x

# Used by createInvite to build share links. In prod tofu sets
# `https://${var.domain_name}`.
XPOOL_PUBLIC_ORIGIN=http://localhost:5173

# --- Optional dev knobs ---
# RUST_LOG=info,api=debug,storage=debug
# XPOOL_NOW=2026-06-20T12:00:00Z   # pin the server clock (spec)

# --- NOT set here ---
# CLOUDFRONT_SECRET — production-only (set by tofu). When unset, the
#   cloudfront_auth middleware is not attached.
# Vite SPA env (VITE_AUTH0_DOMAIN, VITE_AUTH0_CLIENT_ID, VITE_AUTH0_AUDIENCE)
#   — these live in `web/.env.local` (local dev) and `web/.env.production`
#   (deployed builds). dotenvy in the Rust crates does NOT read web/.env.*.

# --- TheSportsDB ---
# TheSportsDB premium API key (V2). Local dev only — prod/dev read it from SSM.
THESPORTSDB_API_KEY=
